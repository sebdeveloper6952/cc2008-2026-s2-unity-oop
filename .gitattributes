# Text files get normalized line endings; Unity reads LF and CRLF alike.
* text=auto

# Unity YAML: always LF, so Mac and Windows clones produce the same files and clean diffs.
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.meta       text eol=lf
*.mat        text eol=lf
*.controller text eol=lf
*.anim       text eol=lf

# Binary assets
*.fbx  binary
*.FBX  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.psd  binary
*.ttf  binary
*.otf  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
